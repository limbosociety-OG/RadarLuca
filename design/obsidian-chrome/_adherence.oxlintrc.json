{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Field/**",
              "components/Figure/**",
              "components/Mosaic/**",
              "components/Plate/**",
              "components/Seal/**",
              "components/SpecLine/**",
              "components/Statement/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Jost|Poppins|Archivo|Cormorant Garamond))/i]",
        "message": "Font not provided by the design system. Available: Jost, Poppins, Archivo, Cormorant Garamond."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|veil|ratio|pad|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: variant, veil, ratio, pad, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:blob|wash|cone|corner|sky|horizon|onyx|slab|paper)$/]",
        "message": "<Field> variant must be one of 'blob' | 'wash' | 'cone' | 'corner' | 'sky' | 'horizon' | 'onyx' | 'slab' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='veil'] > Literal[value!=/^(?:none|bottom|top|left)$/]",
        "message": "<Field> veil must be one of 'none' | 'bottom' | 'top' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|size|tone|style|className|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: value, unit, label, size, tone, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Figure> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Figure> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mosaic'] > JSXAttribute > JSXIdentifier[name!=/^(?:cols|rows|gap|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Mosaic> doesn't accept that prop. Declared props: cols, rows, gap, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plate'] > JSXAttribute > JSXIdentifier[name!=/^(?:corners|tone|pad|border|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Plate> doesn't accept that prop. Declared props: corners, tone, pad, border, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Plate'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Plate> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seal'] > JSXAttribute > JSXIdentifier[name!=/^(?:ring|ringBottom|mark|size|shape|tone|weight|gap|innerRing|openGap|dim|style|className|key|ref|className|style|children)$/]",
        "message": "<Seal> doesn't accept that prop. Declared props: ring, ringBottom, mark, size, shape, tone, weight, gap, innerRing, openGap, dim, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seal'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|oval)$/]",
        "message": "<Seal> shape must be one of 'circle' | 'oval'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seal'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Seal> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|rule|tone|style|className|key|ref|className|style|children)$/]",
        "message": "<SpecLine> doesn't accept that prop. Declared props: label, value, rule, tone, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SpecLine> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|as|caps|tone|measure|children|style|className|key|ref|className|style|children)$/]",
        "message": "<Statement> doesn't accept that prop. Declared props: level, as, caps, tone, measure, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:hero|display|statement|lead|caps|ring)$/]",
        "message": "<Statement> level must be one of 'hero' | 'display' | 'statement' | 'lead' | 'caps' | 'ring'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Statement> tone must be one of 'light' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
